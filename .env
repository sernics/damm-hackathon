# Copy to .env and fill in. Never commit .env.

# Anthropic — used for the structured tip extraction and the moderation pass.
ANTHROPIC_API_KEY=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
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_MODERATION=claude-haiku-4-5-20251001

# OpenAI — used for Whisper STT (cloud API). Cheaper and more reliable than
# running a local model on a hackathon laptop. Set OPENAI_WHISPER_MODE=cloud.
OPENAI_API_KEY=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
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_WHISPER_MODE=cloud

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8001

# Paths (relative to the veteran-capture/ folder unless absolute)
DATA_DIR=./data
RAW_CSV_DIR=../data/csv/Hackaton
GEOCODED_CSV_PATH=../data/custom/geo/geocoded_direcciones.csv
VETERAN_NOTES_DIR=../dataset/veteran_notes

# Logging
LOG_LEVEL=INFO
LOG_JSON=false
